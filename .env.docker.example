# Gene Curator production environment for docker-compose.yml + docker/docker-compose.npm.yml.
# Copy to .env.docker (gitignored) on the server and replace every CHANGE_ME.
#   docker compose -f docker-compose.yml -f docker/docker-compose.npm.yml --env-file .env.docker ...
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Use hex (URL-safe) database passwords: APP_DB_PASSWORD is embedded in DATABASE_URL.

# ── Database ────────────────────────────────────────────────────
POSTGRES_DB=gene_curator
# Schema owner (superuser): runs the migrate service only, never the API
POSTGRES_USER=gene_curator
POSTGRES_PASSWORD=CHANGE_ME
# Runtime role app_user (migration 031, subject to row-level security); different from above
APP_DB_PASSWORD=CHANGE_ME

# ── Backend ─────────────────────────────────────────────────────
# JWT signing key: 32+ random characters; the API refuses placeholders in production
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=info

# Public origin: the SPA, /api and the MCP server (/mcp, OAuth issuer) share one host
GENE_CURATOR_PUBLIC_URL=https://gene-curator.org
GENE_CURATOR_FRONTEND_URL=https://gene-curator.org
ALLOWED_ORIGINS=["https://gene-curator.org"]

# The only address allowed to set X-Forwarded-For: NPM's IP on npm_default, e.g.
#   docker inspect -f '{{(index .NetworkSettings.Networks "npm_default").IPAddress}}' <npm container>
# Never a range: other containers share npm_default and could spoof client IPs.
FORWARDED_ALLOW_IPS=CHANGE_ME

# LLM credential key ring (separate from SECRET_KEY); empty = LLM features unavailable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CREDENTIAL_KEYS=
LLM_CREDENTIAL_ACTIVE_KID=

# Optional: the external NPM network name (default npm_default)
# NPM_SHARED_NETWORK_NAME=npm_default
