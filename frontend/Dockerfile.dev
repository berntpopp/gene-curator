FROM node:20-alpine

WORKDIR /app

# Enable polling-based file watching for Docker
ENV CHOKIDAR_USEPOLLING=true

# Copy package files
COPY package*.json ./

# Install dependencies (deterministic)
RUN npm ci

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
