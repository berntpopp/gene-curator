# Database Configuration
# The API connects as app_user (created by migration 031, subject to RLS);
# POSTGRES_USER owns the schema and runs migrations only. Use two different passwords.
DATABASE_URL=postgresql://app_user:CHANGE_APP_PASSWORD_IN_PRODUCTION@localhost:5432/gene_curator
DATABASE_URL_DOCKER=postgresql://app_user:CHANGE_APP_PASSWORD_IN_PRODUCTION@postgres:5432/gene_curator
APP_DB_PASSWORD=CHANGE_APP_PASSWORD_IN_PRODUCTION
POSTGRES_DB=gene_curator
POSTGRES_USER=gene_curator
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# FastAPI Configuration
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_GENERATE_STRONG_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# LLM credential encryption key ring (separate from SECRET_KEY).
# JSON {kid: key}; generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Add a new kid and switch the active kid to rotate; keep old kids until re-encrypted.
LLM_CREDENTIAL_KEYS={"k1":"CHANGE_ME_GENERATE_FERNET_KEY"}
LLM_CREDENTIAL_ACTIVE_KID=k1

# MCP OAuth (#462): HTTPS API origin (OAuth issuer, MCP at /mcp) and web app origin
GENE_CURATOR_PUBLIC_URL=https://api.your-domain.com
GENE_CURATOR_FRONTEND_URL=https://your-domain.com

# ClinGen Configuration
CLINGEN_SOP_VERSION=v11
CLINGEN_TEMPLATE_VERSION=v5.1

# Frontend Configuration
VITE_API_BASE_URL=https://your-domain.com/api/v1
VITE_ENVIRONMENT=production

# CORS Configuration
ALLOWED_ORIGINS=["https://your-domain.com"]

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Email Configuration (for notifications)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@gene-curator.org